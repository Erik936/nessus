sudo -u postgres psql -d gvmd -c "
-- 1. Ensure 'gvm' user owns both configs
UPDATE configs 
SET owner = (SELECT id FROM users WHERE name = 'gvm') 
WHERE id IN (1, 2);

-- 2. Insert explicit permissions for user 'gvm' on both configs
INSERT INTO permissions (uuid, name, resource_type, resource_id, subject_type, subject_id, owner)
SELECT 
  gen_random_uuid(), 
  'everything', 
  'config', 
  c.id, 
  'user', 
  u.id, 
  u.id
FROM configs c, users u
WHERE c.id IN (1, 2) AND u.name = 'gvm'
ON CONFLICT DO NOTHING;
"
