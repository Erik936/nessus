  gen_random_uuid(), 
  'everything', 
  'config', 
  (SELECT id FROM configs WHERE name = 'Direct Task Config'), 
  'user', 
  u.id, 
  u.id
FROM users u WHERE u.name = 'gvm'
ON CONFLICT DO NOTHING;
"
