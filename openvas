sudo -u postgres psql -d gvmd -c "
-- 1. Insert a direct custom scan config row
INSERT INTO configs (uuid, name, comment, owner)
VALUES (
  gen_random_uuid(),
  'Direct Task Config',
  'Standalone scan config bypassing feed templates.',
  (SELECT id FROM users WHERE name = 'gvm')
);

-- 2. Grant explicit permissions so GSA loads it immediately
INSERT INTO permissions (uuid, name, resource_type, resource, subject_type, subject, owner)
