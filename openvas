sudo -u postgres psql -d gvmd -c "
-- Map available NVTs to 'Full and fast' (id = 1)
INSERT INTO config_nvts (config, nvt)
SELECT 1, id FROM nvts
ON CONFLICT DO NOTHING;

-- Map available NVTs to 'System Discovery' (id = 2)
INSERT INTO config_nvts (config, nvt)
SELECT 2, id FROM nvts
ON CONFLICT DO NOTHING;
"


sudo -u postgres psql -d gvmd -c "
-- Assign ownership and full permissions to user 'gvm'
UPDATE configs SET owner = (SELECT id FROM users WHERE name = 'gvm') WHERE id IN (1, 2);

-- Insert permission entries for the configs if missing
INSERT INTO permissions (uuid, name, resource_type, resource_id, subject_type, subject_id, owner)
SELECT 
  gen_random_uuid(), 
  'everything', 
  'config', 
  c.id, 
  'user', 
  u.id, 
  u.id
FROM configs c, users u
WHERE c.id IN (1, 2) AND u.name = 'gvm'
ON CONFLICT DO NOTHING;
"
