terraform {
  required_providers {
    hyperv = {
      source  = "taliesin/hyperv"
      version = "1.0.3"
    }
  }
}

provider "hyperv" {
  user     = "Administrator"
  password = "YourPassword"
  host     = "127.0.0.1" # Change if managing a remote host
}

# 1. Create an empty 40GB Dynamic VHDX
resource "hyperv_vhd" "empty_disk" {
  path = "C:\\Hyper-V\\Virtual Hard Disks\\NewVM_Disk.vhdx"
  size = 42949672960 # 40GB in bytes
}

# 2. Provision the VM Shell
resource "hyperv_machine_instance" "vm_placeholder" {
  name                = "Terraform-Provisioned-VM"
  generation          = 2
  processor_count     = 2
  static_memory       = true
  memory_startup_bytes = 4294967296 # 4GB

  # Attach the empty disk we created above
  hard_disk_drives {
    path = hyperv_vhd.empty_disk.path
  }

  # Ensure it has a network card for when you are ready to PXE boot or ISO install
  network_adaptors {
    name        = "Primary Adapter"
    switch_name = "Default Switch" # Replace with your actual Switch name
  }
}
